# ─────────────────────────────────────────────────────────────────────────────
# AI Agentic OS — configuration template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Or run the interactive wizard:
#   agent setup
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Anthropic API key (required for all AI features)
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LLM MODELS (optional — defaults shown) ───────────────────────────────────

# Fast model used for most commands
LLM_MODEL=claude-haiku-4-5-20251001

# Expensive model used for deep analysis (agent k8s full-scan, agent resources report)
LLM_EXPENSIVE_MODEL=claude-opus-4-8

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.1

# ── STORAGE (optional — defaults shown) ──────────────────────────────────────

# SQLite memory database path
DB_PATH=data/memory.db

# Human-readable memory vault (markdown files)
VAULT_PATH=data/vault

# ── KUBERNETES (optional) ─────────────────────────────────────────────────────

# Default namespace for k8s commands ("all" scans every namespace)
K8S_DEFAULT_NAMESPACE=all

# ── RESOURCE MONITOR THRESHOLDS (optional — defaults shown) ──────────────────

RESOURCE_CPU_WARNING=70
RESOURCE_CPU_CRITICAL=85
RESOURCE_MEM_WARNING=75
RESOURCE_MEM_CRITICAL=90
RESOURCE_WATCH_INTERVAL=30

# ── AWS Authentication (choose ONE method) ────────────────────────────────────
# Configure interactively with: agent setup  (or switch later: agent aws switch-auth)
# ─────────────────────────────────────────
# RECOMMENDED: IAM Role (for EC2/EKS instances) — no keys needed, boto3/kubectl
# resolve credentials automatically from the instance's attached role.
# Attach an IAM role with the permissions in deployment/aws/atlasos-iam-policy.json.
AWS_AUTH_METHOD=iam_role
AWS_REGION=us-east-1
EKS_CLUSTER_NAME=your-cluster-name

# ALTERNATIVE: Access Keys (local development only — never commit real values)
# AWS_AUTH_METHOD=access_key
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=us-east-1
# EKS_CLUSTER_NAME=your-cluster-name

# ALTERNATIVE: SSO Profile (a named ~/.aws profile — SSO, assumed role, or keys)
# AWS_AUTH_METHOD=sso_profile
# AWS_PROFILE=your-profile-name
# AWS_REGION=us-east-1
# EKS_CLUSTER_NAME=your-cluster-name

# ── GMAIL (optional — needed for agent gmail commands) ────────────────────────
# Set up via: agent gmail auth
# These are auto-populated by the auth flow — do not edit manually.
# GMAIL_CREDENTIALS_PATH=data/gmail_credentials.json
# GMAIL_TOKEN_PATH=data/gmail_token.json

# ── SLACK ALERTS (optional — needed for agent resources watch notifications) ──
# Create an Incoming Webhook at: https://api.slack.com/messaging/webhooks
# 1. Go to https://api.slack.com/apps → Create New App → From scratch
# 2. Enable Incoming Webhooks → Add New Webhook to Workspace → pick a channel
# 3. Copy the webhook URL below
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXXXXXXXXX/BXXXXXXXXXX/xxxxxxxxxxxxxxxxxxxxxxxx

# Slack Signing Secret — needed for interactive Approve/Reject buttons.
# Found at: https://api.slack.com/apps → your app → Basic Information → Signing Secret
# Also set Interactivity Request URL to: https://<your-server>/slack/actions
SLACK_SIGNING_SECRET=

# Send warning-level alerts to Slack (default: only critical alerts are sent)
SLACK_ALERT_ON_WARNING=false

# Send a recovery message when a critical alert clears (default: true)
SLACK_ALERT_ON_RECOVERY=true

# ── PAGERDUTY (optional — auto-page on-call when daemon escalates) ─────────────
# Get your routing key from: PagerDuty → Services → Integrations → Events API v2
# PAGERDUTY_ROUTING_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OPSGENIE (optional — alternative to PagerDuty) ───────────────────────────
# Get your API key from: OpsGenie → Settings → API key management
# OPSGENIE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# OPSGENIE_REGION=us    # or "eu" for EU region

# ── LOGGING (optional) ────────────────────────────────────────────────────────
# "pretty" = human-readable coloured output
# "json"   = structured JSON logs (for log aggregators)
LOG_FORMAT=pretty
