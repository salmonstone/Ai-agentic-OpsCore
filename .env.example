# ─────────────────────────────────────────────────────────────────────────────
# AI Agentic OS — configuration template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Or run the interactive wizard:
#   agent setup
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Anthropic API key (required for all AI features)
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LLM MODELS (optional — defaults shown) ───────────────────────────────────

# Fast model used for most commands
LLM_MODEL=claude-haiku-4-5-20251001

# Expensive model used for deep analysis (agent k8s full-scan, agent resources report)
LLM_EXPENSIVE_MODEL=claude-opus-4-8

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.1

# ── STORAGE (optional — defaults shown) ──────────────────────────────────────

# SQLite memory database path
DB_PATH=data/memory.db

# Human-readable memory vault (markdown files)
VAULT_PATH=data/vault

# ── KUBERNETES (optional) ─────────────────────────────────────────────────────

# Default namespace for k8s commands ("all" scans every namespace)
K8S_DEFAULT_NAMESPACE=all

# ── RESOURCE MONITOR THRESHOLDS (optional — defaults shown) ──────────────────

RESOURCE_CPU_WARNING=70
RESOURCE_CPU_CRITICAL=85
RESOURCE_MEM_WARNING=75
RESOURCE_MEM_CRITICAL=90
RESOURCE_WATCH_INTERVAL=30

# ── AWS (optional — needed for agent aws commands) ────────────────────────────
# These are read from your AWS CLI profile by default.
# Only set these if you want to override the default profile.
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_DEFAULT_REGION=us-east-1

# ── GMAIL (optional — needed for agent gmail commands) ────────────────────────
# Set up via: agent gmail auth
# These are auto-populated by the auth flow — do not edit manually.
# GMAIL_CREDENTIALS_PATH=data/gmail_credentials.json
# GMAIL_TOKEN_PATH=data/gmail_token.json

# ── LOGGING (optional) ────────────────────────────────────────────────────────
# "pretty" = human-readable coloured output
# "json"   = structured JSON logs (for log aggregators)
LOG_FORMAT=pretty
